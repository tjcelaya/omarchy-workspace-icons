#!/usr/bin/env python3
"""Print the windows on each Hyprland workspace, with an icon for each, as one JSON line.

Usage: wsicons-state [--terminals foot,kitty,...] [--programs 'nvim=,btop=btop']

Output: {"windows": [{"ws": 1, "address": "0x...", "class": "foot", "title": "...",
                      "program": "herdr", "icon": "foot", "glyph": "",
                      "agents": [{"agent": "claude", "cwd": "~/src/x", "status": "working",
                                  "pane": "wB:p1", "focus": ["herdr", ...]}]}, ...]}

`icon` is an icon-theme name or an absolute path, resolved by the widget the same way the
launcher resolves desktop-entry icons. `glyph`, when set, is a Nerd Font glyph drawn instead
of the icon (used for terminal programs that ship no icon).

`agents` lists the coding agents running inside a window when a `modelctl-agents` executable
is available (on PATH or in the tjcelaya.modelctl plugin folder); its `focus` argv raises the
agent's pane. Without that tool the list is empty and nothing else changes.
"""

import argparse
import configparser
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
from urllib.parse import urlparse

SHELLS = {"bash", "zsh", "fish", "sh", "dash", "nu", "xonsh", "elvish", "login", "sudo", "doas"}

# Nerd Font glyphs for common terminal programs. Settings can add to or override these.
DEFAULT_PROGRAM_GLYPHS = {
    "nvim": "",
    "vim": "",
    "herdr": "\U000f0674",
    "claude": "\U000f06a9",
    "opencode": "\U000f06a9",
    "btop": "\U000f035b",
    "htop": "\U000f035b",
    "top": "\U000f035b",
    "lazygit": "",
    "lazydocker": "",
    "git": "",
    "tmux": "",
    "ssh": "\U000f08c0",
    "k9s": "\U000f10fe",
    "yazi": "\U000f024b",
    "man": "\U000f02d7",
    "python3": "",
    "python": "",
    "node": "",
}


def app_dirs():
    data_home = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
    data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    return [os.path.join(d, "applications") for d in [data_home] + data_dirs]


def mangle_webapp_url(url):
    """Chromium's --app window class body: host, then the path with '/' turned into '_'."""
    parsed = urlparse(url)
    path = parsed.path or "/"
    return parsed.netloc + "_" + path.replace("/", "_")


def load_desktop_index():
    """Index desktop entries by the keys a window can be matched on. First dir wins."""
    by_wmclass, by_id, by_exec, webapps = {}, {}, {}, []
    for directory in app_dirs():
        for path in glob.glob(os.path.join(directory, "*.desktop")):
            parser = configparser.RawConfigParser(interpolation=None, strict=False)
            try:
                parser.read(path, encoding="utf-8")
                entry = parser["Desktop Entry"]
            except Exception:
                continue
            icon = entry.get("Icon", "").strip()
            if not icon:
                continue
            desktop_id = os.path.basename(path)[: -len(".desktop")].lower()
            by_id.setdefault(desktop_id, icon)
            wmclass = entry.get("StartupWMClass", "").strip().lower()
            if wmclass:
                by_wmclass.setdefault(wmclass, icon)
            try:
                argv = shlex.split(entry.get("Exec", ""))
            except ValueError:
                argv = []
            if not argv:
                continue
            exe = os.path.basename(argv[0])
            if exe == "omarchy-launch-webapp" and len(argv) > 1:
                webapps.append((mangle_webapp_url(argv[1]).lower(), icon))
            elif exe not in ("env", "uwsm-app", "omarchy-launch-or-focus", "omarchy-launch-tui",
                             "omarchy-launch-or-focus-tui", "flatpak", "sh", "bash"):
                by_exec.setdefault(exe.lower(), icon)
    # Longest key first so a specific webapp path beats a bare host.
    webapps.sort(key=lambda item: len(item[0]), reverse=True)
    return by_wmclass, by_id, by_exec, webapps


def icon_for_class(window_class, index):
    by_wmclass, by_id, by_exec, webapps = index
    cls = window_class.lower()
    for key, icon in webapps:
        if key in cls:
            return icon
    if cls in by_wmclass:
        return by_wmclass[cls]
    if cls in by_id:
        return by_id[cls]
    for desktop_id, icon in by_id.items():
        if desktop_id.endswith("." + cls):
            return icon
    if cls in by_exec:
        return by_exec[cls]
    return cls


def process_table():
    """pid -> (ppid, comm) for every readable process."""
    table = {}
    for stat_path in glob.glob("/proc/[0-9]*/stat"):
        try:
            with open(stat_path) as handle:
                raw = handle.read()
        except OSError:
            continue
        # comm sits in parentheses and may itself contain spaces or parens.
        open_paren, close_paren = raw.find("("), raw.rfind(")")
        pid = int(raw[:open_paren])
        comm = raw[open_paren + 1 : close_paren]
        ppid = int(raw[close_paren + 2 :].split()[1])
        table[pid] = (ppid, comm)
    return table


def children_map(table):
    children = {}
    for pid, (ppid, _) in table.items():
        children.setdefault(ppid, []).append(pid)
    return children


def terminal_program(pid, table, children, terminal_comm):
    """Outermost non-shell descendant of a terminal, breadth first; None for a bare shell."""
    frontier = sorted(children.get(pid, []))
    while frontier:
        found = [p for p in frontier if table[p][1] not in SHELLS and table[p][1] != terminal_comm]
        if found:
            return table[found[0]][1]
        frontier = sorted(c for p in frontier for c in children.get(p, []))
    return None


def agents_by_window():
    """Window address -> agents inside it, from modelctl-agents when it is installed."""
    tool = shutil.which("modelctl-agents") or os.path.expanduser(
        "~/.config/omarchy/plugins/tjcelaya.modelctl/bin/modelctl-agents")
    if not os.access(tool, os.X_OK):
        return {}
    try:
        out = subprocess.run([tool], capture_output=True, text=True, timeout=4).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    agents = {}
    for line in out.splitlines():
        fields = line.split("\t")
        if len(fields) < 7:
            continue
        match = re.search(r"address:(0x[0-9a-fA-F]+)", fields[5])
        if not match:
            continue
        try:
            focus = json.loads(fields[6])
        except ValueError:
            focus = []
        agents.setdefault(match.group(1).lower(), []).append({
            "agent": fields[0], "cwd": fields[1], "status": fields[2], "pane": fields[4],
            "focus": focus if isinstance(focus, list) else [],
        })
    return agents


def parse_programs(raw):
    mapping = {}
    for item in re.split(r"[,\n]", raw or ""):
        if "=" in item:
            name, value = item.split("=", 1)
            if name.strip():
                mapping[name.strip()] = value.strip()
    return mapping


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--terminals", default="foot,footclient,Alacritty,kitty,com.mitchellh.ghostty")
    parser.add_argument("--programs", default="")
    args = parser.parse_args()

    terminals = {t.strip().lower() for t in args.terminals.split(",") if t.strip()}
    program_overrides = parse_programs(args.programs)

    clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                        text=True, check=True).stdout or "[]")
    index = load_desktop_index()
    agents = agents_by_window()
    table = children = None

    windows = []
    for client in sorted(clients, key=lambda c: (c["workspace"]["id"], c["at"][0], c["at"][1])):
        ws = client["workspace"]["id"]
        if ws <= 0 or not client.get("mapped", True):
            continue
        window_class = client.get("class") or client.get("initialClass") or ""
        address = str(client.get("address", "")).lower()
        window = {"ws": ws, "address": address, "class": window_class,
                  "title": client.get("title", ""), "program": "",
                  "icon": icon_for_class(window_class, index), "glyph": "",
                  "agents": agents.get(address, [])}

        if window_class.lower() in terminals:
            if table is None:
                table = process_table()
                children = children_map(table)
            pid = client.get("pid", 0)
            terminal_comm = table.get(pid, (0, ""))[1]
            program = terminal_program(pid, table, children, terminal_comm)
            if program:
                window["program"] = program
                override = program_overrides.get(program)
                if override and ("/" in override or override.isascii()):
                    window["icon"] = override
                elif override:
                    window["glyph"] = override
                elif program.lower() in index[1] or program.lower() in index[2]:
                    window["icon"] = index[1].get(program.lower()) or index[2][program.lower()]
                elif program in DEFAULT_PROGRAM_GLYPHS:
                    window["glyph"] = DEFAULT_PROGRAM_GLYPHS[program]
        windows.append(window)

    print(json.dumps({"windows": windows}, ensure_ascii=False))


if __name__ == "__main__":
    main()
